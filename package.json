{
  "name": "websim",
  "version": "1.0.0",
  "description": "Web-based HDL (Verilog/VHDL) simulator with a ModelSim-style workflow (clean-room)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "bench": "esbuild bench/lfsr.ts --bundle --platform=node --format=esm --outfile=dist-bench/lfsr.mjs --log-level=warning && node dist-bench/lfsr.mjs",
    "test:e2e": "vite build && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@yowasp/nextpnr-ice40": "^0.11.96-dev.805",
    "@yowasp/yosys": "^0.70.62-dev.1236",
    "codemirror": "^6.0.2",
    "pyodide": "^314.0.7"
  },
  "type": "module"
}
